{
  "manifest_version": 3,
  "name": "Compartilhar com o macOS",
  "description": "Aciona o Share Sheet nativo do macOS (AirDrop e outros apps) para a aba ativa no Edge.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Compartilhar com o macOS",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "notifications"]
}
